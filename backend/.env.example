# ==============================================================================
# AGENTFORGE BACKEND CONFIGURATION SETTINGS
# ==============================================================================

# The network port the Express application server will listen on in production/local environments.
PORT=5001

# Connection URI for the MongoDB server database.
# Example: mongodb://localhost:27017/agentforge or mongodb+srv://<user>:<password>@cluster.mongodb.net/agentforge
MONGODB_URI=mongodb://localhost:27017/agentforge

# Connection URI for the Redis service cache and message broker (required by BullMQ queues).
# Example: redis://localhost:6379 or rediss://:<password>@redis-host.com:6379
REDIS_URL=redis://localhost:6379

# Hashing key passphrase used for JWT token signatures generation and validation checks.
# Generate a cryptographically strong random string in production.
JWT_SECRET=your-super-secret-jwt-key

# 256-bit hexadecimal string representation used to encrypt third-party developer API keys at rest.
# WARNING: Must be exactly 32-character hex format for AES-256. Do not modify after database is populated.
ENCRYPTION_KEY=f90a6e382d547f2e1a3d5b7c8e9f0c1b

# Third-party LLM API Keys (Optional global defaults - users can override these in settings)
# OPENAI_API_KEY=your-openai-api-key-here
# ANTHROPIC_API_KEY=your-claude-api-key-here
