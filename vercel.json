{
  "buildCommand": "npm run build:shared && npm run build -w frontend",
  "outputDirectory": "frontend/.next",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://agentforge-api.kpebble.com/api/$1"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "https://agentforge-api.kpebble.com/socket.io/$1"
    }
  ]
}
